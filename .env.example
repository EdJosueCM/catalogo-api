# Copia este archivo como .env y reemplaza los valores. Nunca subas .env al repositorio.

# Puerto HTTP de la API
PORT=3000

# Cadena de conexión de MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/catalogo

# Secreto para firmar los JWT: mínimo 32 caracteres aleatorios.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Vigencia del token (formato de jsonwebtoken: 15m, 1h, 1d...)
JWT_EXPIRES_IN=1h

# Costo de bcrypt
BCRYPT_ROUNDS=10

# Datos del administrador que crea "npm run crear-admin"
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=
ADMIN_PASSWORD=
